    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.25.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.3",
